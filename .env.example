# Skopiuj do .env i dostosuj. Plik .env NIE trafia do repozytorium.

# Środowisko uruchomieniowe: local | web
APP_ENV=local

# Opcjonalna ścieżka do katalogu z danymi konfiguracyjnymi (domyślnie: <repo>/data)
# GAS_RD_DATA_DIR=/sciezka/do/data

# --- Przygotowanie pod wdrożenie webowe (Azure) — na razie nieużywane ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
